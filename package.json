{
  "name": "living-journeys",
  "version": "0.0.0",
  "private": true,
  "description": "Living Historical Journeys — an ambient web app for following historical journeys in real (or scaled) time.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @living-journeys/web dev",
    "build": "pnpm --filter @living-journeys/web build",
    "start": "pnpm --filter @living-journeys/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "content:build": "pnpm --filter @living-journeys/content build",
    "validate:content": "pnpm --filter @living-journeys/content validate",
    "test:e2e": "pnpm --filter @living-journeys/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-x6wp-rfwh-hcx7",
        "GHSA-5854-jvxx-2cg9",
        "GHSA-jrc7-96c5-q579",
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-rgj7-g3m4-5g8c",
        "GHSA-wq5f-xc86-pv6w",
        "GHSA-qx2v-qp2m-jg93",
        "GHSA-6g55-p6wh-862q",
        "GHSA-fxqj-rqcc-2cmp",
        "GHSA-r28c-9q8g-f849",
        "GHSA-28wg-ghj8-5hjv",
        "GHSA-2v37-7h3g-55p8",
        "GHSA-68fv-2mgg-jv7q",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
